# ---- Azure AD ----
AZURE_TENANT_ID=<tenant id>
AZURE_API_CLIENT_ID=<client id de vidasalud-api>
FRONTEND_ORIGIN=http://localhost:4200
INTERNAL_KEY=cambia-esta-clave

# dev = H2 en memoria | supabase = una base PostgreSQL por microservicio
DB_PROFILE=supabase

# Cada microservicio de dominio tiene SU propio proyecto Supabase
# (patron database-per-service). Usa el Session pooler, puerto 5432.

# ---- BD de ms-vidasalud-appointments ----
DB_APPOINTMENTS_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
DB_APPOINTMENTS_USER=postgres.<project-ref-1>
DB_APPOINTMENTS_PASSWORD=<password proyecto 1>

# ---- BD de ms-vidasalud-catalog ----
DB_CATALOG_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
DB_CATALOG_USER=postgres.<project-ref-2>
DB_CATALOG_PASSWORD=<password proyecto 2>

# Ruta donde estan clonados los repos de codigo.
# En la EC2:  REPOS_PATH=/home/ec2-user
# En tu PC:   dejalo comentado (usa ../..)
# REPOS_PATH=/home/ec2-user
