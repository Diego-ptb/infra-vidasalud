{
  "rabbit_version": "3.13.0",
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "permissions": [
    {
      "user": "admin",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "users": [
    {
      "name": "admin",
      "password": "admin",
      "tags": "administrator"
    }
  ],
  "policies": [
    {
      "vhost": "/",
      "name": "ha-all",
      "pattern": "^q\\.",
      "apply-to": "queues",
      "definition": {
        "ha-mode": "all",
        "ha-sync-mode": "automatic"
      },
      "priority": 0
    }
  ],
  "exchanges": [
    {
      "name": "cmd.direct",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "cmd.topic",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "cmd.dead.dlx",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "q.cmd.email",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "cmd.dead.dlx",
        "x-dead-letter-routing-key": "q.cmd.email.dlq"
      }
    },
    {
      "name": "q.cmd.email.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "q.cmd.admission",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "cmd.dead.dlx",
        "x-dead-letter-routing-key": "q.cmd.admission.dlq"
      }
    },
    {
      "name": "q.cmd.admission.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "q.cmd.record",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "cmd.dead.dlx",
        "x-dead-letter-routing-key": "q.cmd.record.dlq"
      }
    },
    {
      "name": "q.cmd.record.dlq",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "cmd.direct",
      "vhost": "/",
      "destination": "q.cmd.email",
      "destination_type": "queue",
      "routing_key": "email.send",
      "arguments": {}
    },
    {
      "source": "cmd.topic",
      "vhost": "/",
      "destination": "q.cmd.email",
      "destination_type": "queue",
      "routing_key": "email.*",
      "arguments": {}
    },
    {
      "source": "cmd.dead.dlx",
      "vhost": "/",
      "destination": "q.cmd.email.dlq",
      "destination_type": "queue",
      "routing_key": "q.cmd.email.dlq",
      "arguments": {}
    },
    {
      "source": "cmd.direct",
      "vhost": "/",
      "destination": "q.cmd.admission",
      "destination_type": "queue",
      "routing_key": "admission.ticket",
      "arguments": {}
    },
    {
      "source": "cmd.topic",
      "vhost": "/",
      "destination": "q.cmd.admission",
      "destination_type": "queue",
      "routing_key": "admission.#",
      "arguments": {}
    },
    {
      "source": "cmd.dead.dlx",
      "vhost": "/",
      "destination": "q.cmd.admission.dlq",
      "destination_type": "queue",
      "routing_key": "q.cmd.admission.dlq",
      "arguments": {}
    },
    {
      "source": "cmd.direct",
      "vhost": "/",
      "destination": "q.cmd.record",
      "destination_type": "queue",
      "routing_key": "record.gen",
      "arguments": {}
    },
    {
      "source": "cmd.topic",
      "vhost": "/",
      "destination": "q.cmd.record",
      "destination_type": "queue",
      "routing_key": "record.*",
      "arguments": {}
    },
    {
      "source": "cmd.dead.dlx",
      "vhost": "/",
      "destination": "q.cmd.record.dlq",
      "destination_type": "queue",
      "routing_key": "q.cmd.record.dlq",
      "arguments": {}
    }
  ]
}